        "import sys\n",
        "\n",
        "def clasificar(imc, edad):\n",
        "    if edad < 45:\n",
        "        if imc < 22:\n",
        "            return \"Bajo\"\n",
        "        else:\n",
        "            return \"Medio\"\n",
        "    else:\n",
        "        if imc < 22:\n",
        "            return \"Medio\"\n",
        "        else:\n",
        "            return \"Alto\"\n",
        "\n",
        "def procesar(linea):\n",
        "    partes = linea.split()\n",
        "    masa, altura, edad = float(partes[0]), float(partes[1]), float(partes[2])\n",
        "\n",
        "    if not (0 <= masa <= 150):\n",
        "        return \"ERROR\"\n",
        "    if not (0.1 <= altura <= 2.5):\n",
        "        return \"ERROR\"\n",
        "    if not (0 <= edad <= 110):\n",
        "        return \"ERROR\"\n",
        "\n",
        "    imc = masa / (altura ** 2)\n",
        "    riesgo = clasificar(imc, edad)\n",
        "    return f\"{imc:.1f} {riesgo}\"\n",
        "\n",
        "def main():\n",
        "    print(\"Ingresa masa altura edad separados por espacio.\")\n",
        "    print(\"Presiona Enter en una línea vacía para terminar.\\n\")\n",
        "    while True:\n",
        "        try:\n",
        "            linea = input()\n",
        "        except EOFError:\n",
        "            break\n",
        "        linea = linea.strip()\n",
        "        if not linea:\n",
        "            break\n",
        "        print(procesar(linea))\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ],
